                  "value": "<password>",
                  "description": "(Required) The end-user's Afero password."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth 2.0 grant type."
                }
              ]
            }
